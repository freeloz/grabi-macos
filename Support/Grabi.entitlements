<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- With hardened runtime, camera and microphone access require these
	     entitlements (screen recording needs none). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The interim "Grabi Dev" identity is self-signed (no Team ID), so
	     hardened-runtime library validation would refuse to load the
	     embedded Sparkle.framework. Once every build is signed with the
	     Freeloz SAS Developer ID (Team F6X8HM2S7A), this can be removed:
	     app and framework share a Team ID and validation passes. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- Universal Links: un enlace https://app.grabi.net/w/<slug> abre la
	     app en vez del navegador. Requiere que el App ID en el portal de
	     Apple tenga habilitada la capability "Associated Domains" y que el
	     dominio sirva /.well-known/apple-app-site-association (ya lo hace). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.grabi.net</string>
	</array>
</dict>
</plist>
